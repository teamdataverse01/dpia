# Copy to .env and adjust. Never commit .env.
APP_ENV=dev
APP_BASE_URL=http://localhost:8090
# Path prefix when mounted inside the CU portal (e.g. /privacy-risk). Empty for root.
APP_BASE_PATH=

DB_DSN=pgsql:host=db;port=5432;dbname=privacy_risk
DB_USER=privacy_risk
DB_PASSWORD=privacy_risk_dev

# Evidence files are stored here — must be OUTSIDE the web root.
STORAGE_PATH=/app/storage/evidence
LOG_PATH=/app/storage/logs
EVIDENCE_MAX_BYTES=10485760

# Auth adapter: "dev" (user switcher, dev only) or "portal_session" (reads the CU portal's PHP session).
AUTH_ADAPTER=dev
PORTAL_SESSION_USER_KEY=portal_user
# Mailer adapter: "log" writes mails to LOG_PATH/mail.log
MAILER_ADAPTER=log
MAIL_FROM=privacy-risk@covenantuniversity.edu.ng

# --- Demo deployment (e.g. Railway) ---
# AUTH_ADAPTER=demo shows a sign-in page; all demo accounts share DEMO_PASSWORD.
DEMO_PASSWORD=
# 1 = load demo users, vendors, DPIAs and templates on first start
SEED_DEMO=0
# Alternative to DB_DSN/DB_USER/DB_PASSWORD: postgres://user:pass@host:port/dbname
DATABASE_URL=
