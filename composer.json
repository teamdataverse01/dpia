{
    "name": "duxor/cu-privacy-risk",
    "description": "Unified Privacy Risk Module (Vendor Risk Assessment + DPIA) for Covenant University",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/console migrate",
        "seed": "php bin/console seed"
    },
    "config": {
        "sort-packages": true
    }
}
